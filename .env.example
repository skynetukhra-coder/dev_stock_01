# Engine: SIGNAL, PAPER, or LIVE. LIVE is not implemented and must remain disabled.
TRADING_MODE=SIGNAL
STRATEGY_VERSION=0.1.0
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# Backend
DATABASE_URL=postgresql+psycopg://prophecy:change-me@localhost:5432/prophecy
